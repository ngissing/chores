# Copy this to .env.production.local on the Pi and fill in your Google API key.
# Only GOOGLE_API_KEY is used by the app (for AI chore-image generation).
# See docs/deploy-raspberry-pi.md for the full Raspberry Pi setup.
GOOGLE_API_KEY=your_key_here
DB_PATH=/home/pi/chores/data/chores.db
PORT=3000
NODE_ENV=production
